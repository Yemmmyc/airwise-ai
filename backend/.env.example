# AIRWISE AI Backend Configuration (Example)
# Copy this file to .env for local configuration overrides.
# Never commit .env or expose API keys to the frontend.

AIRWISE_APP_NAME="AIRWISE AI API"
AIRWISE_APP_VERSION="0.3.0"
AIRWISE_ENVIRONMENT="development"
AIRWISE_API_V1_PREFIX="/api/v1"

# Comma-separated or JSON array of allowed frontend origins
AIRWISE_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Default location when none is specified
AIRWISE_DEFAULT_LOCATION_ID="lagos-ng"

# Open-Meteo Air Quality API Configuration (No API key required)
AIRWISE_OPEN_METEO_BASE_URL="https://air-quality-api.open-meteo.com/v1/air-quality"
AIRWISE_OPEN_METEO_DOMAINS="cams_global"
AIRWISE_OPEN_METEO_TIMEOUT_SECONDS=8.0
AIRWISE_OPEN_METEO_CACHE_TTL_SECONDS=300
AIRWISE_OPEN_METEO_FORECAST_HOURS=24

# Historical Air Quality Engine & Local SQLite Persistence
AIRWISE_HISTORY_DB_PATH="data/airwise_history.db"
AIRWISE_HISTORY_CACHE_TTL_SECONDS=1200
AIRWISE_HISTORY_REFRESH_MAX_AGE_SECONDS=21600
AIRWISE_HISTORY_TIMEOUT_SECONDS=12.0

# Google Gemini API Configuration (Backend-only; leave blank if running without AI assistant)
# Obtain a free-tier Google AI Studio API key and place it in backend/.env (never in frontend/.env.local)
GEMINI_API_KEY=""
AIRWISE_GEMINI_MODEL="gemini-2.5-flash"
AIRWISE_GEMINI_TIMEOUT_SECONDS=15.0
